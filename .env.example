# Public canonical site origin
NEXT_PUBLIC_SITE_URL=https://intellisense.cloud

# Contact notification. Keep these values server-side; never prefix them NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Intellisense Website <website@intellisense.cloud>"
CONTACT_TO_EMAIL=info@intellisense.cloud

# Required for production contact form rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
